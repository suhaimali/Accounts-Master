{
  "name": "accounts-master",
  "version": "1.0.0",
  "description": "Accounts Master - Daily Accounting & Cash Reconciliation Platform",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --no-warnings ./node_modules/concurrently/dist/bin/concurrently.js --names \"server,client\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run server\" \"npm run client\"",
    "server": "nodemon --no-warnings --watch server server/index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.2.1",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.0",
    "xlsx": "^0.18.5"
  }
}
